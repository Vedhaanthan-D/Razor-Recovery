# Server
PORT=3000

# Supabase — backend uses the service_role key. NEVER expose it to the frontend.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# LLM (Phase 2) — classification fallback chain: OpenRouter (primary) -> Groq -> Mistral
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key

# LLM models (override per provider)
# NB: model availability is account-specific and changes without notice. Verify a value works
#   (curl https://openrouter.ai/api/v1/models  /  https://api.groq.com/openai/v1/models) first —
#   e.g. llama-3.1-8b-instant has 404'd on some Groq accounts (use openai/gpt-oss-20b instead).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GROQ_MODEL=llama-3.1-8b-instant
MISTRAL_MODEL=ministral-8b-2512

# Nemotron Ultra is a slow (~40 tok/s) reasoning model; the primary gets a longer per-call budget.
# Fallbacks use the 15s default. Classify runs after the webhook 200s, so this never delays Razorpay.
OPENROUTER_TIMEOUT_MS=30000

# Safety ceilings (NOT business logic): cap API calls per server session to protect free-tier quota
# from runaway loops during testing. In-memory, reset on restart. Checked via GET /api/debug/usage.
MAX_LLM_CALLS_PER_SESSION=100
MAX_RAZORPAY_CALLS_PER_SESSION=50
